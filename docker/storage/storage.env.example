# MinIO S3-compatible object storage
# Min 8 chars for MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=lab_admin
MINIO_ROOT_PASSWORD=change-me
# S3 region — set to match what your SDK expects
MINIO_REGION=us-east-1
# Uncomment if accessing Console behind a reverse proxy
# MINIO_BROWSER_REDIRECT_URL=http://localhost:8201
