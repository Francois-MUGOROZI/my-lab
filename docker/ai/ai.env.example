# AI gateway (LiteLLM) — copy to docker/ai/ai.env. Never commit real values.

# Key apps send as `Authorization: Bearer <key>`. Must start with "sk-".
LITELLM_MASTER_KEY=sk-change-me

# Provider keys (held by the gateway only, never by the apps)
OPENAI_API_KEY=change-me
GEMINI_API_KEY=change-me
ANTHROPIC_API_KEY=change-me

# Azure OpenAI resource (Azure portal: Keys and Endpoint)
AZURE_API_KEY=change-me
AZURE_API_BASE=https://<resource-name>.openai.azure.com/
AZURE_API_VERSION=2024-10-21           # a version the resource supports

# Shared my-lab Redis (databases stack). Must match REDIS_PASSWORD in
# docker/databases/databases.env.
REDIS_PASSWORD=change-me
