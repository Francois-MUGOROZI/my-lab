# PostgreSQL
POSTGRES_DB=lab_db
POSTGRES_USER=lab_user
POSTGRES_PASSWORD=change-me

# MySQL
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=lab_db
MYSQL_USER=lab_user
MYSQL_PASSWORD=change-me
# Allow root connections from any host (dev only)
MYSQL_ROOT_HOST=%

# SQL Server
ACCEPT_EULA=Y
# Min 8 chars: uppercase, lowercase, digit, special char
MSSQL_SA_PASSWORD=change-me
# Express | Developer | Standard | Enterprise
MSSQL_PID=Express

# MongoDB Community Server
# Note: uses MONGODB_ prefix (not MONGO_) unlike the standard mongo image
MONGODB_INITDB_ROOT_USERNAME=lab_admin
MONGODB_INITDB_ROOT_PASSWORD=change-me
MONGODB_INITDB_DATABASE=lab_db

# Redis (also used by BullMQ from any connecting app)
REDIS_PASSWORD=change-me
