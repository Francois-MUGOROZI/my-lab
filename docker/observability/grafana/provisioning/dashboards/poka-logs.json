{
  "uid": "poka-logs",
  "title": "Poka — Logs",
  "description": "Structured logs from all Poka services via OTEL → Loki.",
  "tags": ["poka", "logs", "loki"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "loki", "uid": "poka-loki" },
        "query": "label_values(service_name)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": "error,warn,info,debug",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "value": "$__all", "text": "All" }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "value": "", "text": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Volume",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 6 },
      "datasource": { "type": "loki", "uid": "poka-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "drawStyle": "bars",
            "barAlignment": 0
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum by (service_name, level) (count_over_time({service_name=~\"$service\", level=~\"$level\"} [$__interval]))",
          "legendFormat": "{{service_name}} / {{level}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Errors & Warnings",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 },
      "datasource": { "type": "loki", "uid": "poka-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byFrameRefID", "options": "errors" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byFrameRefID", "options": "warnings" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "options": { "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\", level=\"error\"} [$__interval]))",
          "legendFormat": "errors — {{service_name}}",
          "refId": "errors"
        },
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\"$service\", level=\"warn\"} [$__interval]))",
          "legendFormat": "warnings — {{service_name}}",
          "refId": "warnings"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Count (last hour)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 6, "w": 6, "h": 3 },
      "datasource": { "type": "loki", "uid": "poka-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"$service\", level=\"error\"} [1h]))",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Warning Count (last hour)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 6, "w": 6, "h": 3 },
      "datasource": { "type": "loki", "uid": "poka-loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 50 }
            ]
          },
          "mappings": []
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["sum"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(count_over_time({service_name=~\"$service\", level=\"warn\"} [1h]))",
          "legendFormat": "Warnings",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Log Stream",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 18 },
      "datasource": { "type": "loki", "uid": "poka-loki" },
      "options": {
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{service_name=~\"$service\", level=~\"$level\"} |~ \"(?i)$search\"",
          "legendFormat": "",
          "refId": "A"
        }
      ]
    }
  ]
}
